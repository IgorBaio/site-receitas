---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL ?? '/';
---

<Layout title="404 — página não encontrada | Igor Baio Soares">
  <section style="padding: 5rem 0; text-align: center;">
    <p class="eyebrow">ops!</p>
    <h1>404</h1>
    <p style="max-width: 45ch; margin: 1rem auto; color: var(--ink-soft);">
      A página que você está procurando não existe ou foi movida.
    </p>
    <a href={base} class="button">Voltar para a página inicial</a>
  </section>
</Layout>
