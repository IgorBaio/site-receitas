---
interface Props {
  slug: string;
  title: string;
  categoria: string;
  dificuldade: string;
  tempoPreparo: number;
  imagemCapa: string;
}

const base = import.meta.env.BASE_URL ?? '/';
const { slug, title, categoria, dificuldade, tempoPreparo, imagemCapa } = Astro.props;
const imageSrc = `${base}${imagemCapa.replace(/^\/+/, '')}`;
---

<a href={`${base}receitas/${slug}/`} class="recipe-card-link">
  <article class="recipe-card">
    <span class="tag">{categoria}</span>
    <img src={imageSrc} alt={title} />
    <h3>{title}</h3>
    <div class="recipe-meta">
      <span>{tempoPreparo} min</span>
      <span>&middot;</span>
      <span>{dificuldade}</span>
    </div>
  </article>
</a>
